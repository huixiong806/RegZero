  "briefing": [
    {
      "tag": "新概念",
      "text": "**寄存器**，是 CPU 内部用来临时存放整数的高速「格子」。"
    },
    {
      "tag": "本关环境",
      "text": "这一关提供了 `t0`、`t1`、`t2` 三个寄存器，其中 `t0` 和 `t1` 里已经放好了两个整数。"
    },
    {
      "tag": "通关目标",
      "text": "算出 `t0` 与 `t1` 的和，并把结果存入 `t2`。"
    },
    {
      "tag": "怎么开始",
      "text": "先动手试算，再写出**指令**提交。"
    }
  ],
  "sandbox": {
    "type": "manual-cpu",
    "focusWarmupFirst": true,
    "modules": ["regs", "alu"],
    "recordToAsm": true,
    "focusRegs": ["t0", "t1", "t2"],
    "regRoles": {
      "t0": "输入 A",
      "t1": "输入 B",
      "t2": "结果"
    },
    "aluOps": ["+"],
    "allowCopy": false,
    "warmupPuzzle": {
      "prompt": "把 t0(3) 和 t1(5) 放进运算台的左右两个输入槽，目标选 t2，再点「执行一步」。",
      "initial": {
        "regs": { "t0": 3, "t1": 5, "t2": 0 }
      },
      "goal": {
        "regs": { "t2": 8 }
      }
    }
  },
  "editor": {
    "readonlyPrefix": 1,
    "readonlySuffix": 1
  },
  "hints": [
    { "level": 1, "type": "diagram", "content": "add 指令的格式是：add 目标, 左输入, 右输入。先写结果放哪儿，再写谁加谁。" },
    { "level": 2, "type": "steps", "content": "目标寄存器填 t2，两个输入寄存器填 t0 和 t1，用英文逗号分隔。" },
    { "level": 3, "type": "snippet", "content": "add t2, t0, t1" }
  ],
