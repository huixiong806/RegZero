  "briefing": [
    {
      "tag": "任务背景",
      "text": "休眠仓里的裸机终端**「零号机」**刚刚通电，系统一片空白。第一步：测试芯片最基础的加法通路是否完好。"
    },
    {
      "tag": "新概念：寄存器",
      "text": "**寄存器**是 CPU 内部用来临时存放整数的高速「格子」。本关开放了 `t0`、`t1`、`t2` 三个格子，其中 `t0` 和 `t1` 里已放好测试数值。"
    },
    {
      "tag": "通关目标",
      "text": "先在左侧动手试算，再用指令算出 `t0 + t1` 并把结果存入 `t2`。"
    }
  ],
  "sandbox": {
    "type": "manual-cpu",
    "focusWarmupFirst": true,
    "modules": [
      "regs",
      "alu"
    ],
    "recordToAsm": true,
    "focusRegs": [
      "t0",
      "t1",
      "t2"
    ],
    "regRoles": {
      "t0": "输入 A",
      "t1": "输入 B",
      "t2": "输出"
    },
    "aluOps": [
      "+"
    ],
    "allowCopy": false,
    "warmupPuzzle": {
      "prompt": "把 t0(3) 和 t1(5) 放进运算台的左右两个输入槽，目标选 t2，再点「执行一步」。",
      "initial": {
        "regs": {
          "t0": 3,
          "t1": 5,
          "t2": 0
        }
      },
      "goal": {
        "regs": {
          "t2": 8
        }
      }
    }
  },
