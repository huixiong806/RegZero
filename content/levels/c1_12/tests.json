  "goal": {
    "type": "static",
    "tests": [
      {
        "name": "t0 = -16, t1 = 100：算术右移保持负号，无符号比 -16 更大",
        "initial": {
          "regs": {
            "t0": -16,
            "t1": 100
          }
        },
        "expected": {
          "regs": {
            "t2": -4,
            "t3": -16
          }
        }
      },
      {
        "name": "t0 = 20, t1 = -1：-1 (0xFFFFFFFF) 是最大无符号数",
        "initial": {
          "regs": {
            "t0": 20,
            "t1": -1
          }
        },
        "expected": {
          "regs": {
            "t2": 5,
            "t3": -1
          }
        }
      },
      {
        "name": "t0 = -1, t1 = -2：-1 算术右移仍是 -1，且无符号大于 -2",
        "initial": {
          "regs": {
            "t0": -1,
            "t1": -2
          }
        },
        "expected": {
          "regs": {
            "t2": -1,
            "t3": -1
          }
        }
      },
      {
        "name": "正数比较：t0 = 32, t1 = 50",
        "initial": {
          "regs": {
            "t0": 32,
            "t1": 50
          }
        },
        "expected": {
          "regs": {
            "t2": 8,
            "t3": 50
          }
        }
      }
    ]
  },
