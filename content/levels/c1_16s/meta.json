  "hints": [
    {
      "level": 1,
      "type": "diagram",
      "content": "不要用双分支递归！用迭代滚动两个寄存器：初值 t1 = 0 (F0), t2 = 1 (F1)，每轮推进一次，循环 n 次后 t1 就是 F(n)！"
    },
    {
      "level": 2,
      "type": "steps",
      "content": "1. t1 = 0, t2 = 1；2. loop: beq t0, zero, done；3. add t3, t1, t2；4. mv t1, t2；5. mv t2, t3；6. addi t0, t0, -1；7. j loop；8. done:。"
    },
    {
      "level": 3,
      "type": "snippet",
      "content": "addi t1, zero, 0\naddi t2, zero, 1\nloop:\nbeq  t0, zero, done\nadd  t3, t1, t2\nmv   t1, t2\nmv   t2, t3\naddi t0, t0, -1\nj    loop\ndone:"
    }
  ],
