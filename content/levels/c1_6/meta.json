{
  "id": "1-6",
  "chapter": 1,
  "order": 6,
  "kind": "lesson",
  "title": "打破直线：PC 指针、标签与分支（blt / j）",
  "mode": "online",
  "allowLocalFile": true,
  "language": "asm",
  "prerequisites": ["1-5"],
  "concepts": ["pc", "label", "blt", "bge", "j"],
  "goalSummary": {
    "before": "t0 与 t1 中存有两个整数",
    "after": "将 t0 与 t1 中的较大值存入 t2"
  },
  "briefing": [
    {
      "tag": "新概念",
      "text": "CPU 靠 **PC（程序计数器）** 决定下一条执行哪一行指令，默认总是从上往下顺序执行。"
    },
    {
      "tag": "学会拐弯",
      "text": "给代码贴上**标签**（如 `use_t1:`），再配合条件跳转 `blt` / `bge` 与无条件跳转 `j`，就能像 `if / else` 一样拐弯！"
    },
    {
      "tag": "通关目标",
      "text": "比较 `t0` 与 `t1`，把其中**较大**的数存入 `t2`。"
    }
  ],
  "sandbox": {
    "type": "manual-cpu",
    "modules": ["regs", "pcTrack"],
    "recordToAsm": true,
    "focusRegs": ["t0", "t1", "t2"],
    "regRoles": {
      "t0": "输入 A",
      "t1": "输入 B",
      "t2": "较大值"
    },
    "pcTrack": {
      "cases": [
        {
          "label": "场景 1：t0=4, t1=9（触发跳转）",
          "initial": { "regs": { "t0": 4, "t1": 9, "t2": 0 } },
          "goal": { "regs": { "t2": 9 } }
        },
        {
          "label": "场景 2：t0=12, t1=5（走主干再 j 跳过）",
          "initial": { "regs": { "t0": 12, "t1": 5, "t2": 0 } },
          "goal": { "regs": { "t2": 12 } }
        }
      ],
      "program": [
        { "op": "blt", "a": "t0", "b": "t1", "target": "use_t1", "asm": "blt t0, t1, use_t1" },
        { "op": "mv", "dst": "t2", "src": "t0", "asm": "mv t2, t0" },
        { "op": "j", "target": "done", "asm": "j done" },
        { "label": "use_t1", "op": "mv", "dst": "t2", "src": "t1", "asm": "mv t2, t1" },
        { "label": "done", "op": "halt", "asm": "ecall" }
      ]
    },
    "warmupPuzzle": {
      "prompt": "亲手扮演 PC 指针走完分支轨道：遇到 blt 判断大小决定是否跳转，并体会 j done 如何跳过另一条分支。",
      "initial": {
        "regs": { "t0": 4, "t1": 9, "t2": 0 }
      },
      "goal": {
        "regs": { "t2": 9 }
      }
    }
  },
  "editor": {
    "readonlyPrefix": 1,
    "readonlySuffix": 1
  },
  "hints": [
    { "level": 1, "type": "diagram", "content": "先判断 t0 < t1 时跳去执行 mv t2, t1；否则顺序执行 mv t2, t0 后，一定要用 j done 跳过 use_t1 分支。" },
    { "level": 2, "type": "steps", "content": "1. blt t0, t1, use_t1；2. mv t2, t0；3. j done；4. 标签 use_t1: 写 mv t2, t1；5. 标签 done: 接末尾 ecall。" },
    { "level": 3, "type": "snippet", "content": "blt t0, t1, use_t1\nmv  t2, t0\nj   done\nuse_t1:\nmv  t2, t1\ndone:" }
  ],
  "wikiRefs": ["rv32-branch"]
}
