{
  "id": "1-2",
  "chapter": 1,
  "order": 2,
  "kind": "lesson",
  "title": "凭空加七",
  "mode": "online",
  "allowLocalFile": true,
  "language": "asm",
  "prerequisites": [
    "1-1"
  ],
  "concepts": [
    "immediate",
    "addi"
